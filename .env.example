# === Kalodata Open Center API (server-side only — NEVER exposed to the browser) ===

# Your Kalodata Open Center secret key.
KALODATA_API_KEY=

# HTTP header name Kalodata Open Center uses for auth. Confirmed from the official
# "Quick API Example" in their docs: curl -H "secret-key: YOUR_API_KEY" ...
KALODATA_AUTH_HEADER=secret-key

# Optional scheme prefix sent before the key in that header (e.g. "Bearer"). Kalodata's
# secret-key header takes the raw key value, so this stays blank.
KALODATA_AUTH_SCHEME=

# === App mode ===

# true  = use built-in mock data, no Kalodata credentials required (default, safe out of the box)
# false = call the real Kalodata Open Center API using the credentials above
USE_MOCK_DATA=true

# Port the Express backend listens on.
PORT=3001
